# API Keys
GROQ_API_KEY=your_groq_api_key_here

# Optional Groq model routing
# Ordered fallback chain (comma-separated). If empty, backend uses an internal default chain.
GROQ_MODEL_CHAIN=allam-2-7b,groq/compound,groq/compound-mini,llama-3.1-8b-instant,llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-prompt-guard-2-22m,meta-llama/llama-prompt-guard-2-86m,openai/gpt-oss-120b,openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b,qwen/qwen3-32b
# Preferred models used by services as starting points in the chain
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_QUALITY_MODEL=llama-3.3-70b-versatile
# Retries per model before moving to the next one on rate-limit errors
GROQ_RATE_LIMIT_RETRIES_PER_MODEL=2

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=7d

# File Upload Limits
FILE_SIZE_LIMIT_MB=50

# AI Usage / Credits
AI_USAGE_ENABLED=true
AI_WEEKLY_CREDITS=30
AI_BURST_WINDOW_SECONDS=300
AI_BURST_LIMIT=3

# Content Safety
CONTENT_SAFETY_ENABLED=true
CONTENT_SAFETY_STRICT=false
CONTENT_SAFETY_LOCAL_ONLY=false

# Firebase Push Notifications (optional)
# Paste the full JSON from the Firebase service account key file
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
